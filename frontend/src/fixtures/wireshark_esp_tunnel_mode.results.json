    "grade": "B",
    "summary": "Good security posture. AES-256-CBC with HMAC-SHA2-256 and DH Group 14 (MODP-2048) meets baseline RFC 8221 requirements. Minor deductions for non-AEAD cipher (padding oracle exposure) and Group 14 approaching end-of-recommendation lifetime.",
    "findings": [
      {
        "finding_id": "F-001",
        "severity": "MEDIUM",
        "category": "Cryptographic Weakness",
        "parameter": "esp_encryption",
        "observed_value": "ENCR_AES_CBC",
        "compliant_value": "ENCR_AES_GCM_16",
        "title": "Non-AEAD Cipher (AES-CBC) Selected",
        "description": "AES-256-CBC requires a separate integrity algorithm and is susceptible to CBC padding oracle timing attacks (CVE-2016-2183 class). RFC 8221 Section 5 recommends MUST NOT use AES-CBC for new deployments — prefer AES-GCM-16 or ChaCha20-Poly1305.",
        "cve": null,
        "attack_vector": "Padding oracle side-channel; requires active MITM position",
        "remediation": "Replace ENCR_AES_CBC with ENCR_AES_GCM_16 (key_length=256) in both IKE and ESP proposals. Remove separate AUTH_HMAC_SHA2_256_128 — AEAD provides integrity natively.",
        "rfc_reference": "RFC 8221 Section 5 — ENCR_AES_CBC SHOULD NOT (ESP)"
      },
      {
        "finding_id": "F-002",
        "severity": "LOW",
        "category": "Key Exchange",
        "parameter": "dh_group",
        "observed_value": "14 (MODP-2048)",
        "compliant_value": "19 (ECP-256) or 31 (Curve25519)",
        "title": "DH Group 14 (MODP-2048) Approaching Deprecation",
        "description": "DH Group 14 (2048-bit MODP/Oakley) is currently SHOULD (RFC 8247 Section 4) but is scheduled for deprecation as NSA/NIST move toward elliptic-curve groups. No known practical attacks exist, but upgrade path to Group 19/20/31 is recommended.",
        "cve": null,
        "attack_vector": "Discrete logarithm (NFS); not practical below 112-bit security level for 2048-bit MODP",
        "remediation": "Upgrade DH group to 19 (ECP-256), 20 (ECP-384), or 31 (Curve25519) in both IKE and ESP proposals for future-proof key exchange.",
        "rfc_reference": "RFC 8247 Section 4 — DH Group 14 SHOULD (IKEv2)"
      }
    ],
