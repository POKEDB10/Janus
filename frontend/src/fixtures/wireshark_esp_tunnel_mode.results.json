    "remediation_config": "# =============================================================================\n# Janus Automated strongSwan Remediation Configuration\n# Generated based on RFC 8221 (ESP), RFC 8247 (IKEv2) & NIST SP 800-77 Rev. 1\n# =============================================================================\n# Action required: Replace AES-CBC with AES-GCM (AEAD) and upgrade DH group\n\nconnections {\n    janus-remediated {\n        version = 2\n        local_addrs = %defaultroute\n        remote_addrs = %any\n\n        local {\n            auth = pubkey\n            certs = cert.pem\n            id = vpn-gateway.internal\n        }\n\n        remote {\n            auth = pubkey\n            id = %any\n        }\n\n        # Upgraded IKEv2 Proposal: AES-256-GCM (AEAD) + SHA-256 PRF + DH Group 19 (ECP-256)\n        # Replaces: AES-256-CBC + HMAC-SHA2-256 + DH Group 14 (MODP-2048)\n        proposals = aes256gcm16-prfsha256-ecp256\n\n        rekey_time = 4h\n\n        children {\n            net-traffic {\n                local_ts = 0.0.0.0/0\n                remote_ts = 0.0.0.0/0\n                mode = tunnel\n\n                # Upgraded ESP: AES-256-GCM-16 AEAD + ECP-256 PFS\n                # Eliminates padding oracle risk of AES-CBC\n                esp_proposals = aes256gcm16-ecp256\n\n                dpd_action = restart\n                close_action = restart\n                rekey_time = 4h\n            }\n        }\n    }\n}",
