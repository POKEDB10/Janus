# ==============================================================================
# Janus Production Environment Configuration Template (.env.example)
# Copy this file to .env on your server and populate secrets:
#   cp .env.example .env
# NEVER commit the actual .env file with real secrets into version control.
# ==============================================================================

# ── Master Authentication & Admin Secrets ──────────────────────────────────────
# Master API Key required for privileged routes (/api/live/* and /api/history/*)
# Generate on host with: openssl rand -hex 32
JANUS_API_KEY=replace_with_a_secure_random_64_char_hex_key

# Cryptographic salt for generating per-capture HMAC tokens (BOLA defense)
# Generate on host with: openssl rand -hex 32
JANUS_TOKEN_SECRET=replace_with_another_secure_random_salt

# Enable authentication enforcement (always true in production)
JANUS_REQUIRE_AUTH=true

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Tunnel connector token obtained from Cloudflare Zero Trust Dashboard
# (Networks -> Tunnels -> Select Docker environment -> copy string after --token)
CLOUDFLARE_TUNNEL_TOKEN=eyJh...

# ── Concurrency & Performance Limits (4GB RAM / 2-Core i3 Host) ───────────────
# Max simultaneous PCAP analyses (keeps CPU/RAM bounded on 2-core CPU)
JANUS_MAX_CONCURRENT_ANALYSES=1

# Application log level (DEBUG, INFO, WARNING, ERROR)
JANUS_LOG_LEVEL=INFO
